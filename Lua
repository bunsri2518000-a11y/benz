-- ระบบบิน
local flyBV, flyBG
local flyUp, flyDown = false, false
local controls

local function getMoveVector()
    if not controls then
        pcall(function()
            local ps = LocalPlayer:FindFirstChild("PlayerScripts")
            local pm = ps and ps:FindFirstChild("PlayerModule")
            if pm then controls = require(pm):GetControls() end
        end)
    end
    if controls then
        local ok, v = pcall(function() return controls:GetMoveVector() end)
        if ok and typeof(v) == "Vector3" then return v end
    end
    local hum = getHum()
    if hum then return cam().CFrame:VectorToObjectSpace(hum.MoveDirection) end
    return Vector3.zero
end

local function stopFly()
    if flyBV then pcall(function() flyBV:Destroy() end) flyBV = nil end
    if flyBG then pcall(function() flyBG:Destroy() end) flyBG = nil end
    local hum = getHum()
    if hum then hum.PlatformStand = false end
end

local function startFly()
    local root, hum = getRoot(), getHum()
    if not root or not hum then return end
    stopFly()
    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBV.Velocity = Vector3.zero
    flyBV.Parent = root
    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBG.P = 9e4
    flyBG.CFrame = root.CFrame
    flyBG.Parent = root
    hum.PlatformStand = true
end

-- กล้องอิสระ (Freecam): กล้องบินไปรอบแมพ ตัวละครยืนอยู่ที่เดิม
local fcPos, fcYaw, fcPitch = Vector3.zero, 0, 0
local fcAnchoredBefore = false

local function startFreecam()
    local c = cam()
    local cf = c.CFrame
    fcPos = cf.Position
    fcPitch, fcYaw = cf:ToOrientation()
    c.CameraType = Enum.CameraType.Scriptable
    local root = getRoot()
    if root then
        fcAnchoredBefore = root.Anchored
        root.Anchored = true
    end
end

local function stopFreecam()
    local c = cam()
    c.CameraType = Enum.CameraType.Custom
    local hum = getHum()
    if hum then c.CameraSubject = hum end
    local root = getRoot()
    if root then root.Anchored = fcAnchoredBefore or State.freeze end
end

-- หมุนกล้องอิสระด้วยการลากนิ้วบนจอ (หรือคลิกขวาค้างบน PC)
track(UserInputService.InputChanged:Connect(function(input, gpe)
    if not State.freecam or gpe then return end
    local t = input.UserInputType
    if t == Enum.UserInputType.Touch
        or (t == Enum.UserInputType.MouseMovement
            and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)) then
        fcYaw -= input.Delta.X * 0.006
        fcPitch = math.clamp(fcPitch - input.Delta.Y * 0.006, -1.5, 1.5)
    end
end))

track(RunService.RenderStepped:Connect(function(dt)
    if State.fov then
        cam().FieldOfView = State.fovVal
    end

    if State.freecam then
        local mv = getMoveVector()
        local rot = CFrame.fromOrientation(fcPitch, fcYaw, 0)
        local vert = (flyUp and 1 or 0) - (flyDown and 1 or 0)
        local move = rot.RightVector * mv.X + rot.LookVector * (-mv.Z) + Vector3.new(0, vert, 0)
        fcPos += move * State.freecamSpeed * dt
        cam().CFrame = CFrame.new(fcPos) * rot
    end

    if State.fly then
        if not flyBV or not flyBV.Parent then startFly() end
        if flyBV and flyBG then
            local cf = cam().CFrame
            local mv = getMoveVector()
            local dir = cf.RightVector * mv.X + cf.LookVector * (-mv.Z)
            local vert = (flyUp and 1 or 0) - (flyDown and 1 or 0)
            flyBV.Velocity = dir * State.flySpeed + Vector3.new(0, vert * State.flySpeed, 0)
            flyBG.CFrame = cf
            local hum = getHum()
            if hum and not hum.PlatformStand then hum.PlatformStand = true end
        end
    end
end))


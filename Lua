-- เดินทะลุกำแพงแบบอิงเหตุการณ์ (ไม่ต้องไล่ GetDescendants ทุกเฟรม หรือสุ่มสแกนเป็นรอบ)
-- เมื่อมีชิ้นส่วนใหม่โผล่ขึ้นมา (หยิบของ ใส่เสื้อผ้า โมเดลเปลี่ยน) จะจับได้ทันทีผ่าน DescendantAdded
-- จึงไม่มีอาการติดกำแพงกะทันหันเหมือนระบบสแกนเป็นรอบ
local noclipParts = {}      -- part -> true
local noclipCharConn        -- connection ของตัวละครปัจจุบัน ตัดทิ้งเมื่อเกิดใหม่

local function watchNoclipPart(p)
    if p:IsA("BasePart") then
        noclipParts[p] = true
        if State.noclip and p.CanCollide then p.CanCollide = false end
    end
end

local function rebuildNoclipWatch()
    table.clear(noclipParts)
    if noclipCharConn then noclipCharConn:Disconnect() end
    local char = getChar()
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do watchNoclipPart(p) end
    noclipCharConn = track(char.DescendantAdded:Connect(watchNoclipPart))
end
rebuildNoclipWatch()

-- Stepped: วิ่ง / กระโดด / ทะลุ / บันนี่ฮอป / กันนั่ง / ตรึง
track(RunService.Stepped:Connect(function()
    local hum = getHum()
    local root = getRoot()

    if State.speed and hum and hum.WalkSpeed ~= State.speedVal then
        hum.WalkSpeed = State.speedVal
    end

    if State.jump and hum then
        if hum.UseJumpPower then
            hum.JumpPower = State.jumpVal
        else
            hum.JumpHeight = (State.jumpVal ^ 2) / (2 * 196.2)
        end
    end

    if State.bhop and hum and hum.MoveDirection.Magnitude > 0
        and hum.FloorMaterial ~= Enum.Material.Air then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end

    if State.antiSit and hum and hum.Sit then
        hum.Sit = false
    end

    if State.noclip then
        for p in pairs(noclipParts) do
            if p.Parent and p.CanCollide then p.CanCollide = false end
        end
    end

    if State.freeze and root and not root.Anchored then
        root.Anchored = true
    end
end))


local canFile = type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
local AUTOLOAD_FILE = "HubPro_autoload.txt"
local THEME_FILE = "HubPro_theme.txt"
local NO_SAVE = {freeze = true, autoLoad = true, freecam = true} -- ฟังก์ชันที่ไม่บันทึก
local currentSlot = 1

local function slotFile(n) return "HubPro_slot" .. n .. ".json" end
local function wpFile() return "HubPro_wp_" .. tostring(game.PlaceId) .. ".json" end

local function fileExists(name)
    if not canFile then return false end
    local ok, r = pcall(isfile, name)
    return ok and r == true
end

local function collectConfig()
    local cfg = {toggles = {}, values = {}}
    for key, s in pairs(Setters) do
        if s.isOn() and not NO_SAVE[key] then cfg.toggles[key] = true end
    end
    for key, i in pairs(Inputs) do
        cfg.values[key] = i.get()
    end
    return cfg
end

local function applyConfig(cfg)
    -- ตั้งค่าตัวเลขก่อน แล้วค่อยเปิด/ปิดสวิตช์
    for key, val in pairs(cfg.values or {}) do
        if Inputs[key] and tonumber(val) then Inputs[key].set(tonumber(val)) end
    end
    for key, s in pairs(Setters) do
        if not NO_SAVE[key] then
            local want = cfg.toggles ~= nil and cfg.toggles[key] == true
            if s.isOn() ~= want then s.set(want) end
        end
    end
end

local function saveSlot(n)
    if not canFile then notify("executor นี้ไม่รองรับการบันทึกไฟล์") return end
    local ok = pcall(function()
        writefile(slotFile(n), HttpService:JSONEncode(collectConfig()))
    end)
    notify(ok and ("บันทึกสล็อต " .. n .. " แล้ว") or "บันทึกไม่สำเร็จ")
end

local function loadSlot(n, silent)
    if not canFile or not fileExists(slotFile(n)) then
        if not silent then notify("สล็อต " .. n .. " ยังว่างอยู่") end
        return
    end
    local ok, cfg = pcall(function()
        return HttpService:JSONDecode(readfile(slotFile(n)))
    end)
    if ok and type(cfg) == "table" then
        applyConfig(cfg)
        if not silent then notify("โหลดสล็อต " .. n .. " แล้ว") end
    else
        notify("ไฟล์สล็อต " .. n .. " เสียหาย")
    end
end

local function deleteSlot(n)
    if canFile and type(delfile) == "function" and fileExists(slotFile(n)) then
        pcall(delfile, slotFile(n))
        notify("ลบสล็อต " .. n .. " แล้ว")
    else
        notify("สล็อต " .. n .. " ยังว่างอยู่")
    end
end


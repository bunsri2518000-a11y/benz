-- แตะที่ไหนก็วาร์ปไปที่นั่น
local function tapTeleport(pos)
    local root = getRoot()
    if not root then return end
    local ray = cam():ScreenPointToRay(pos.X, pos.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {getChar()}
    local res = Workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
    if res then
        root.CFrame = CFrame.new(res.Position + Vector3.new(0, 3.5, 0))
    end
end
track(UserInputService.TouchTap:Connect(function(positions, gpe)
    if State.tapTP and not gpe and positions[1] then tapTeleport(positions[1]) end
end))
track(UserInputService.InputBegan:Connect(function(input, gpe)
    if State.tapTP and not gpe and input.UserInputType == Enum.UserInputType.MouseButton1 then
        tapTeleport(input.Position)
    end
end))

-- ออโต้คลิก
-- แก้บั๊ก: เดิมมี fallback ไปจำลองคลิกเมาส์ทั่วจอ (mouse1click / VirtualUser) เวลาไม่ได้ถือของ
-- ซึ่งบนมือถือมันไปแย่งจุดสัมผัสจริงของนิ้วเรา ทำให้กดปุ่มอื่นไม่ติดขณะเปิดออโต้คลิกอยู่
-- ตอนนี้ตัดส่วนนั้นออกทั้งหมด: จะตีให้ก็ต่อเมื่อถืออาวุธ/อุปกรณ์ (Tool) อยู่เท่านั้น
-- ถ้าไม่ได้ถืออะไร จะไม่ทำอะไรเลย ไม่ไปยุ่งกับหน้าจอ นิ้วเรากดปุ่มอื่นได้ตามปกติ
local function doClick()
    local char = getChar()
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() tool:Activate() end)
    end
end

-- ลูปออโต้คลิกแยกออกมาต่างหาก ไม่ผูกกับเฟรมเรตเหมือน Heartbeat (ซึ่งเคยล็อกไว้แค่ ~60 ครั้ง/วิ)
-- ตอนนี้ปรับค่าได้สูงสุดตามที่ตั้งในช่องกรอก ความเร็วจริงยังขึ้นกับตัวเกม/อุปกรณ์ด้วย
local autoClickToken = 0
local function startAutoClickLoop()
    autoClickToken += 1
    local myToken = autoClickToken
    task.spawn(function()
        while State.autoClick and myToken == autoClickToken do
            doClick()
            task.wait(1 / math.max(State.cps, 1))
        end
    end)
end


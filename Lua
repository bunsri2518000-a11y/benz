local function parseHex(s)
    s = tostring(s or ""):gsub("#", ""):gsub("%s", "")
    if #s == 6 and not s:find("%X") then
        local c = Color3.fromRGB(tonumber(s:sub(1, 2), 16), tonumber(s:sub(3, 4), 16), tonumber(s:sub(5, 6), 16))
        return c, string.upper(s)
    end
    return nil
end

local function setThemeColors(c)
    COL.accent = c
    COL.on = c:Lerp(Color3.new(1, 1, 1), 0.12)
    local lum = c.R * 0.299 + c.G * 0.587 + c.B * 0.114
    COL.onText = lum > 0.55 and Color3.fromRGB(8, 20, 12) or Color3.fromRGB(255, 255, 255)
end

